# Point the frontend at your backend. Leave unset to run on demo data.
# VITE_API_URL=https://api.example.com/v1

# Track A avatar engine (avatar-engine/, run: avatar-engine serve). When set, creating an
# avatar from an uploaded video trains a real digital twin, and Create Video renders it.
# VITE_AVATAR_ENGINE_URL=http://127.0.0.1:8100

# Track B backend -> local LiveKit server (infra/livekit). Dev-only credentials.
# TRACKB_LIVEKIT_URL=ws://localhost:7880
# TRACKB_LIVEKIT_API_KEY=devkey
# TRACKB_LIVEKIT_API_SECRET=dev-secret-change-me-0123456789abcdef

# LLM: "gemini" (free tier, key from Google AI Studio -- keep billing OFF on that project),
# "ollama" (local) or "mock". flash-lite is the low-latency choice for live conversation.
# TRACKB_LLM_PROVIDER=gemini
# TRACKB_GEMINI_API_KEY=
# TRACKB_GEMINI_MODEL=gemini-flash-lite-latest
